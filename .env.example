# Copy to .env.local and fill in from your Supabase project (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key — server only, never expose. Used by the iCal feed.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional: Resend API key for email notifications. Leave blank to disable email.
RESEND_API_KEY=
# Sender for notification emails; must be on a domain verified in Resend.
NOTIFY_EMAIL_FROM="Family Phases <phases@natearnold.me>"
# Base URL of the deployed app (for links in emails / iCal)
NEXT_PUBLIC_APP_URL=http://localhost:3000
